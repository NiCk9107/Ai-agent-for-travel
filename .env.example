# Скопируйте в .env и вставьте ключ. Подходит любой OpenAI-совместимый API с поддержкой tools.
# OpenRouter работает из РФ: https://openrouter.ai/settings/keys
# Gemini напрямую из РФ НЕ работает (User location is not supported).
LLM_BASE_URL=
OPENROUTER_API_KEY=your_api_key_here
LLM_API_KEY=your_key_here
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_FALLBACK_MODEL=recursive/flint-v1.0:free
ALLOWED_ORIGINS=